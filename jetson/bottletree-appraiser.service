[Unit]
Description=Bottle Tree counter appraiser (FastAPI, on-device Nemotron via Ollama)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/service
EnvironmentFile=@REPO@/service/.env
Environment=PORT=8080
ExecStart=@REPO@/service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
