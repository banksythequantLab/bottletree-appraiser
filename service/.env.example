# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron does identification, pricing reasoning and listing copy
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# "auto" = pick the first candidate your key can see (run scripts/probe_models.py to check)
VISION_MODEL=auto
# VISION_CANDIDATES=nvidia/nemotron-3-nano-omni-30b-a3b,Qwen/Qwen2.5-VL-72B-Instruct

# Optional: live comparables via Tavily. Without it, prices are model-estimated and flagged.
TAVILY_API_KEY=

# Shared secret the Bottle Tree worker sends as X-Appraiser-Key (leave empty for local dev)
APPRAISER_SERVICE_KEY=

MAX_PHOTOS=8
PORT=8080
